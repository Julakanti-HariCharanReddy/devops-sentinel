# Copy to backend/.env and fill in. Never commit .env.
SARVAM_API_KEY=
# Optional overrides (defaults shown). Models per https://docs.sarvam.ai/api-reference-docs/chat/chat-completions
SARVAM_MODEL=sarvam-105b
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_TIMEOUT_S=90
# Optional shared access code required by the API (recommended for any public deployment).
ACCESS_CODE=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Supabase persistence (optional; falls back to local SQLite). Use the SECRET / service_role key,
# never the publishable/anon key. Apply backend/supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
